PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/trimly

# Redis Provider Switch: 'local' or 'upstash' (default: local)
REDIS_PROVIDER=local

# Upstash Redis URL (used when REDIS_PROVIDER=upstash)
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Local Redis settings (used when REDIS_PROVIDER=local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3001,https://trimly-frontend.vercel.app
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SHORT_URL_BASE=http://localhost:4000
WORKER_ENABLED=true
